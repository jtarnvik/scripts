<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jtarnvik.glambackup.plist
  Place in: ~/Library/LaunchAgents/

  Register:   launchctl load ~/Library/LaunchAgents/com.jtarnvik.glambackup.plist
  Unregister: launchctl unload ~/Library/LaunchAgents/com.jtarnvik.glambackup.plist
  Run now:    launchctl start com.jtarnvik.glambackup
  Check log:  tail -f ~/scripts/glam-backup/glam_backup.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jtarnvik.glambackup</string>

    <!-- launchd starts jobs with a minimal PATH; Homebrew's rsync is in /opt/homebrew/bin
         (the script calls it by its full path from the config as well) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jesper/scripts/glam-backup/glam_backup.sh</string>
    </array>

    <!-- Every Sunday at 05:00, after MySQL (02:00), Paprika (03:00) and Paperless (04:00, which also
         writes to MediaOverflow) -->
    <!-- Weekday: 0=Sunday, 1=Monday ... 6=Saturday -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/jesper/scripts/glam-backup/glam_backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jesper/scripts/glam-backup/glam_backup.log</string>
</dict>
</plist>

# raid_watch.conf.template
# Copy this file to raid_watch.conf and fill in the values.
# raid_watch.conf is excluded from git via .gitignore — never commit it.

# Pushover credentials (from pushover.net)
PUSHOVER_USER_KEY=""
PUSHOVER_API_TOKEN=""

# Name of this machine in notification titles, e.g. "Production" or "Media server"
HOST_LABEL=""

# RAID sets that must be present on this machine. A set that is missing from
# diskutil's list (not assembled, disks unplugged) is reported as a problem.
# Example: EXPECTED_RAID_SETS=("MediaStore" "MediaBack2")
EXPECTED_RAID_SETS=()
